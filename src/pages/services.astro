---
// @ts-ignore
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import LEDOutdoor from "assets/LED - Outdoor.jpg";
import Sectionhead from "@components/sectionhead.astro";
import ServicesComponent from "@components/services.astro";
import { getImage } from "astro:assets";

const optimizedBackground = await getImage({ src: LEDOutdoor, format: "webp" });

const metaDescription =
  "Explore our advertising solutions including outdoor LED advertising, indoor advertising, events, branding, and production services.";
const metaTitle = "Advertising Solutions";
const metaKeywords =
  "outdoor advertising,indoor advertising,events,branding,production";
---

<head>
  <meta name="description" content={metaDescription} />
  <meta property="og:title" content="Advertising Solutions" />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={optimizedBackground.src!} />
  <meta property="title" content={metaTitle} />
  <meta property="keywords" content={metaKeywords} />
</head>

<Container>
  <Layout title="Services">
    <Sectionhead>
      <Fragment slot="title">Services</Fragment>
      <Fragment slot="desc">
        Some of the services we offer to our clients.
      </Fragment>
    </Sectionhead>
    <div class="px-5 mb-12">
      <ServicesComponent isHomePage={false} />
    </div>
  </Layout>
</Container>
