---
// Modal.astro
const { isOpen, onClose, location } = Astro.props;
---

{isOpen && (
  <div class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
    <div class="bg-white p-6 rounded-lg shadow-lg max-w-md w-full">
      <h2 class="text-xl font-bold mb-2">{location.name}</h2>
      <img src={location.image} alt={location.name} class="w-full rounded-md mb-4" />
      <p>{location.description}</p>
      <iframe
        width="100%"
        height="315"
        src={location.video}
        title="YouTube video player"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
      <button onclick={onClose} class="mt-4 bg-blue-500 text-white px-4 py-2 rounded">
        Close
      </button>
    </div>
  </div>
)}