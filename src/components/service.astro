---

<head>
  <meta name="description" content={metaDescription} />
  <meta property="og:title" content="Advertising Solutions" />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={optimizedBackground.src!} />
  <meta property="title" content={metaTitle} />
  <meta property="keywords" content={metaKeywords} />
</head>

<div
  class="mt-16"
  class:list={{
    visible: true,
    block: isHomePage,
    hidden: !isHomePage,
  }}>
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight capitalize">
    advertising solutions
  </h2>
  <p class="text-lg mt-4 text-slate-600">
    Astro comes batteries included. It takes the best parts of state-of-the-art
    tools and adds its own innovations.
  </p>
</div>

<div
  class:list={{
    "grid sm:grid-cols-2 mt-16 gap-16": true,
    "lg:grid-cols-3": isHomePage,
    "lg:grid-cols-2 max-w-4xl justify-center items-center mx-auto": !isHomePage,
  }}>
  {
    services.map((item) => (
      <a href={item?.link}>
        <div class="flex flex-col bg-slate-50 p-4 rounded-md transition-transform duration-300 hover:scale-110">
          <Picture
            src={item?.image ?? ""}
            alt={item?.title ?? ""}
            sizes="(max-width: 800px) 100vw, 400px"
            width={400}
            height={400}
            class="w-full rounded-md group-hover:shadow-xl bg-white object-cover object-center"
            format="jpg"
          />
          <div class="flex gap-2 items-center justify-center my-2">
            <div class="mt-1 bg-[#0A91D9] rounded-full  p-2 w-8 h-8 shrink-0">
              <Icon class="text-white" name={item.icon} />
            </div>
            <h3 class="font-semibold text-lg text-[#0A91D9]">
              {item.title}
            </h3>{" "}
          </div>
          <div>
            <p class="text-slate-500 mt-2">{item.description}</p>
            {/* <div>
            <p class="text-slate-500 mt-2">{item.locations}</p>
          </div> */}
          </div>
        </div>
      </a>
    ))
  }
</div>
